{
  "name": "yama-db-web",
  "version": "1.0.0",
  "type": "module",
  "description": "A comprehensive Japanese mountain map, powered by OpenLayers",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "lint": "eslint 'src/*.js'",
    "minify": "cleancss -o css/mountain.css src/mountain.css",
    "build": "vite build --emptyOutDir",
    "build:dev": "vite build --mode development --emptyOutDir",
    "build:prod": "vite build --mode production --emptyOutDir",
    "preview": "vite preview"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yama-db/web.git"
  },
  "author": "Nyanta Anineco <anineco@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/yama-db/web/issues"
  },
  "homepage": "https://github.com/yama-db/web#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "vite": "^8.2.1",
    "vite-plugin-env-compatible": "^2.0.1"
  },
  "dependencies": {
    "ga-gtag": "^1.2.0",
    "ol": "^10.10.0",
    "ol-layerswitcher": "^4.1.2",
    "ol-popup": "^5.1.1",
    "tippy.js": "^6.3.7"
  },
  "browserslist": [
    "defaults"
  ],
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
